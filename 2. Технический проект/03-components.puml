@startuml
!include <C4/C4_Component>
!include <tupadr3/devicons/python>
!include <tupadr3/devicons/nginx>
!include <tupadr3/devicons2/postgresql>
!include <tupadr3/devicons/redis>
!include <tupadr3/font-awesome/folder>
!include <tupadr3/font-awesome/cogs>
!include <tupadr3/font-awesome/envelope>
!include <tupadr3/font-awesome/bell>

LAYOUT_TOP_DOWN()

skinparam linetype polyline
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 4
skinparam nodesep 65
skinparam ranksep 110
skinparam wrapWidth 160
skinparam wrapMessageWidth 110
skinparam ArrowColor #788795
skinparam ArrowFontColor #33485D
skinparam ArrowFontSize 10
skinparam titleFontSize 22
skinparam padding 4
skinparam LegendFontColor #536575

UpdateElementStyle("container", $bgColor="#438DD5", $fontColor="#FFFFFF", $borderColor="#438DD5")
UpdateElementStyle("component", $bgColor="#85BBF0", $fontColor="#071625", $borderColor="#5A9BD5")
UpdateElementStyle("external_system", $bgColor="#777777", $fontColor="#FFFFFF", $borderColor="#777777")

UpdateBoundaryStyle("", $fontColor="#33485D", $borderColor="#96A4B1", $borderStyle=DashedLine())
UpdateContainerBoundaryStyle($fontColor="#1D2D3E", $borderColor="#52718E", $type="Container: Python / FastAPI")

AddRelTag("api", $lineColor="#438DD5", $textColor="#2B6CB0")
AddRelTag("domain", $lineColor="#B7791F", $textColor="#975A16")
AddRelTag("module", $lineColor="#008D80", $textColor="#00695F")
AddRelTag("storage", $lineColor="#805AD5", $textColor="#553C9A")
AddRelTag("job", $lineColor="#DD6B20", $textColor="#C05621")

hide stereotype

title Диаграмма компонентов — Word Hunt Backend API

Container(nginx, "Reverse Proxy", "Nginx", "HTTPS → FastAPI", $sprite="nginx")

Container_Boundary(backend, "Backend API — модульный монолит") {

    Boundary(api, "API — HTTP и проверка запроса") {
        Component(auth_dependency, "SessionAuthDependency", "Python / FastAPI Depends", "Сессия → user_id", $sprite="python")
        Component(api_router, "ApiRouter", "Python / FastAPI APIRouter", "HTTP-маршруты семи модулей", $sprite="python")
        Component(error_handler, "ApiErrorHandler", "Python / FastAPI", "HTTP-статус и безопасные ошибки", $sprite="python")
    }

    Boundary(jobs, "Background Jobs — фоновые точки входа") {
        Component(photo_cleanup, "PhotoCleanupJob", "Python / периодическая задача", "Очистка временных фото", $sprite="python")
        Component(reminder_job, "ReminderJob", "Python / периодическая задача", "Запуск напоминаний", $sprite="python")
    }


    Boundary(application, "Application — сценарии семи модулей") {
        Component(identity, "IdentityService", "Python / identity", "Профиль, вход, выход", $sprite="python")
        Component(recognition, "RecognitionService", "Python / recognition", "Фото → слово, перевод, пример", $sprite="python")
        Component(photo_service, "PhotoService", "Python / photos", "Подготовка и сохранение фото", $sprite="python")
        Component(vocabulary, "VocabularyService", "Python / vocabulary", "Карточки и коллекции", $sprite="python")
        Component(training, "TrainingService", "Python / training", "Карточки словаря; запись ответов", $sprite="python")
        Component(progress, "ProgressService", "Python / progress", "Статистика и достижения", $sprite="python")
        Component(notifications, "NotificationService", "Python / notifications", "Настройки и напоминания", $sprite="python")
    }

    Boundary(domain, "Domain — модели и правила") {
        Component(identity_domain, "identity.domain", "Python", "User, Profile; правила аккаунта", $sprite="python")
        Component(photo_domain, "photos.domain", "Python", "PhotoMetadata, PhotoState;\nPhotoRules: JPEG/PNG ≤ 5 МБ", $sprite="python")
        Component(vocabulary_domain, "vocabulary.domain", "Python", "WordCard, WordCollection;\nправила карточек", $sprite="python")
        Component(learning_domain, "training.domain &\nprogress.domain", "Python / группа пакетов", "ReviewAnswer;\nправила прогресса", $sprite="python")
        Component(reminder_policy, "notifications.domain", "Python", "ReminderPolicy;\nвремя и условия", $sprite="python")
    }


    Boundary(infrastructure, "Infrastructure — реализации адаптеров БД и внешних сервисов") {
        Component(session_store, "RedisSessionStore", "Python / ISessionStore", "Хеш токена, user_id, TTL", $sprite="python")
        Component(email_sender, "EmailSender", "Python / IEmailSender", "Письмо с кодом", $sprite="python")
        Component(ollama_client, "OllamaClient", "Python / IImageRecognizer", "HTTP-клиент модели", $sprite="python")
        Component(photo_storage, "FilePhotoStorage", "Python / IPhotoStorage", "Закрытые JPEG-файлы", $sprite="python")
        Component(repositories, "PostgresRepositories", "Python / группа репозиториев", "Репозитории модулей;\nProgressQueries", $sprite="python")
        Component(push_sender, "PushSender", "Python / IPushSender", "Доставка push", $sprite="python")
    }
}

ContainerDb(redis, "Session Store", "Redis", "Серверные сессии\nсо сроком действия", $sprite="redis")
System_Ext(email, "Email Service", "Провайдер отправки писем", $sprite="envelope")
Container(ai, "ImageRecognition Service", "Ollama / Qwen3-VL-2B-Instruct", "Модель на собственном\nоборудовании", $sprite="cogs")
ContainerDb(photos, "Blob Storage", "Закрытый каталог / JPEG", "Временные и постоянные\nфотографии", $sprite="folder")
ContainerDb(db, "Database", "PostgreSQL", "Профили, карточки, коллекции;\nответы, метаданные, настройки", $sprite="postgresql")
System_Ext(push, "Push Service", "Провайдер Android push", $sprite="bell")

Lay_R(api, jobs)
Lay_R(auth_dependency, api_router)
Lay_R(api_router, error_handler)

Lay_R(identity, recognition)
Lay_R(recognition, photo_service)
Lay_R(photo_service, vocabulary)
Lay_R(vocabulary, training)
Lay_R(training, progress)
Lay_R(progress, notifications)

Lay_R(identity_domain, photo_domain)
Lay_R(photo_domain, vocabulary_domain)
Lay_R(vocabulary_domain, learning_domain)
Lay_R(learning_domain, reminder_policy)

Lay_R(session_store, email_sender)
Lay_R(email_sender, ollama_client)
Lay_R(ollama_client, photo_storage)
Lay_R(photo_storage, repositories)
Lay_R(repositories, push_sender)

Lay_D(identity_domain, email_sender)
Lay_D(photo_domain, photo_storage)
Lay_D(vocabulary_domain, repositories)
Lay_D(reminder_policy, push_sender)


Rel_D(nginx, api_router, "Запросы", "HTTP / REST", $tags="api")

Rel_L(api_router, auth_dependency, "Сессия", "", $tags="api")
Rel_R(api_router, error_handler, "Ошибки", "", $tags="api")

Rel_D(api_router, identity, "Аккаунт", "", $tags="api")
Rel_D(api_router, recognition, "Распознавание", "", $tags="api")
Rel_D(api_router, photo_service, "Фото", "", $tags="api")
Rel_D(api_router, vocabulary, "Словарь", "", $tags="api")
Rel_D(api_router, training, "Тренировки", "", $tags="api")
Rel_D(api_router, progress, "Прогресс", "", $tags="api")
Rel_D(api_router, notifications, "Напоминания", "", $tags="api")

Rel_D(photo_cleanup, photo_service, "Очистить временные фото", "", $tags="job")
Rel_D(reminder_job, notifications, "Запустить напоминания", "", $tags="job")


Rel_R(recognition, photo_service, "Подготовить фото", "", $tags="module")
Rel_L(vocabulary, photo_service, "Закрепить фото", "", $tags="module")
Rel_L(training, vocabulary, "Получить карточки", "", $tags="module")

Rel_D(identity, identity_domain, "Правила аккаунта", "", $tags="domain")
Rel_D(photo_service, photo_domain, "Состояние фото", "", $tags="domain")
Rel_D(vocabulary, vocabulary_domain, "Правила карточек", "", $tags="domain")
Rel_D(training, learning_domain, "ReviewAnswer", "", $tags="domain")
Rel_D(progress, learning_domain, "Правила прогресса", "", $tags="domain")
Rel_D(notifications, reminder_policy, "Условия напоминаний", "", $tags="domain")


Rel_D(auth_dependency, session_store, "Проверить токен", "", $tags="storage")

Rel_D(identity, session_store, "Создать / отозвать сессию", "", $tags="storage")
Rel_D(identity, email_sender, "Код входа", "", $tags="storage")
Rel_D(identity, repositories, "Профиль", "", $tags="storage")

Rel_D(recognition, ollama_client, "Распознать", "", $tags="storage")

Rel_D(photo_service, photo_storage, "Файлы JPEG", "", $tags="storage")
Rel_D(photo_service, repositories, "Метаданные фото", "", $tags="storage")

Rel_D(vocabulary, repositories, "Чтение / запись карточек", "", $tags="storage")
Rel_D(training, repositories, "Сохранить ответ", "", $tags="storage")
Rel_D(progress, repositories, "Агрегаты ответов", "", $tags="storage")

Rel_D(notifications, repositories, "Настройки / устройства", "", $tags="storage")
Rel_D(notifications, push_sender, "Отправить push", "", $tags="storage")


Rel_D(session_store, redis, "Сессии / TTL", "RESP / TCP", $tags="api")
Rel_D(email_sender, email, "Письмо", "SMTP + TLS", $tags="api")
Rel_D(ollama_client, ai, "Фото → результат", "HTTP / JSON + Base64", $tags="api")
Rel_D(photo_storage, photos, "Файлы", "Файловый API", $tags="api")
Rel_D(repositories, db, "Данные модулей", "SQL / PostgreSQL", $tags="api")
Rel_D(push_sender, push, "Push", "HTTPS / API", $tags="api")

@enduml