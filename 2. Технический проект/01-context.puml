@startuml WordHunt_Context
!include <C4/C4_Context>
!include <tupadr3/font-awesome/bell>
!include <tupadr3/font-awesome/book>
!include <tupadr3/font-awesome/envelope>

LAYOUT_TOP_DOWN()
skinparam defaultFontName Arial
skinparam shadowing false
skinparam nodesep 50
skinparam ranksep 65
skinparam wrapWidth 200
skinparam wrapMessageWidth 150
UpdateElementStyle("component", $bgColor="#85BBF0", $fontColor="#000000", $borderColor="#85BBF0")
title Диаграмма контекста — Word Hunt

Person(guest, "Гость", "Регистрируется\nи входит в приложение")
Person(user, "Пользователь", "Создаёт карточки\nи изучает слова")
Person(admin, "Администратор", "Обслуживает сервер\nи нейросетевую модель")
System(wh, "Word Hunt", "Фото → карточки → тренировки.\nЛичный словарь, коллекции,\nстатистика и достижения", $sprite="book")
System_Ext(email, "Email Service", "Доставляет письма\nс кодом входа", $sprite="envelope")
System_Ext(push, "Push Service", "Доставляет напоминания\nна Android-устройства", $sprite="bell")
Rel(guest, wh, "Регистрируется, входит", "Мобильное приложение")
Rel(user, wh, "Фото, слова, тренировки", "Мобильное приложение")
Rel(admin, wh, "Логи, метрики, модель", "Серверные инструменты")
Rel_D(wh, email, "Отправляет код входа")
Rel_D(wh, push, "Отправляет напоминание")
Rel(email, guest, "Доставляет код", "Email")
Rel(push, user, "Доставляет уведомление")
Lay_R(guest, user)
Lay_R(user, admin)
Lay_R(email, push)
Lay_D(wh, email)
Lay_D(wh, push)

footer Администратор работает через серверные инструменты. Отдельного административного интерфейса Android нет.
@enduml
