@startuml WordHunt_Component
!include <C4/C4_Component>
!include <tupadr3/devicons/android>
!include <tupadr3/devicons2/postgresql>
!include <tupadr3/font-awesome/folder>
!include <tupadr3/font-awesome/cogs>

title Word Hunt — C4 Component: Backend API
LAYOUT_TOP_DOWN()
skinparam defaultFontName Arial
skinparam wrapWidth 210
skinparam wrapMessageWidth 160

Container(mobile, "Мобильное приложение", "Android 8.0+", "Интерфейс пользователя.", $sprite="android")

Container_Boundary(backend, "Backend API — модульный монолит") {
    Component(api, "HTTP API", "HTTP-обработчики", "Принимает запросы, проверяет сессию через модуль авторизации, возвращает данные и единые ошибки.")
    Component(auth, "Авторизация и профиль", "Модуль backend", "Регистрация, вход и выход, профиль, серверные сессии и проверка прав.")
    Component(recognition, "Распознавание", "Модуль backend", "Вызывает модель и приводит результат к единому виду. Обрабатывает ошибки распознавания.", $sprite="cogs")
    Component(dictionary, "Словарь и коллекции", "Модуль backend", "Создание карточки после подтверждения, просмотр, поиск, изменение, удаление и коллекции.")
    Component(training, "Тренировки", "Модуль backend", "Выдаёт карточки и сохраняет каждый ответ: помню или не помню.")
    Component(stats, "Статистика и достижения", "Модуль backend", "Считает показатели по истории ответов, серии занятий и достижения.")
    Component(photoManager, "Управление фотографиями", "Модуль backend", "Проверяет формат и размер, готовит JPEG, управляет временными фото и доступом владельца.", $sprite="folder")
}

ContainerDb(db, "База данных", "PostgreSQL", "Профили, сессии, карточки, коллекции, история ответов и сведения о фото.", $sprite="postgresql")
Container(photos, "Хранилище фотографий", "Закрытая папка / JPEG", "Временные и постоянные снимки.", $sprite="folder")
Container(ai, "Распознавание изображений", "Ollama / Qwen3-VL-2B-Instruct", "Выполняет модель на собственном оборудовании.", $sprite="cogs")

Rel(mobile, api, "Передаёт данные и фото, получает результат", "HTTPS / REST: JSON, multipart/form-data; JPEG в ответе")
Rel(api, auth, "Вход, профиль и проверка сессии")
Rel(api, recognition, "Распознать фото")
Rel(api, dictionary, "Операции с карточками и коллекциями")
Rel(api, training, "Начать тренировку, сохранить ответ")
Rel(api, stats, "Получить прогресс и достижения")
Rel(api, photoManager, "Получить фотографию владельца")
Rel(recognition, photoManager, "Подготовить и временно сохранить фото")
Rel(dictionary, photoManager, "Закрепить или удалить фото карточки")
Rel(training, dictionary, "Получить карточки пользователя")
Rel(auth, db, "Профили и сессии", "SQL / протокол PostgreSQL")
Rel(dictionary, db, "Карточки и коллекции", "SQL / протокол PostgreSQL")
Rel(training, db, "История ответов", "SQL / протокол PostgreSQL")
Rel(stats, db, "Данные для расчёта показателей", "SQL / протокол PostgreSQL")
Rel(photoManager, db, "Владелец и состояние фото", "SQL / протокол PostgreSQL")
Rel(photoManager, photos, "Читает, сохраняет и удаляет фото", "Файловые операции / JPEG")
Rel(recognition, ai, "Передаёт фото; получает слово и пример с переводом", "Локальный HTTP API / JSON, Base64")

note bottom of backend
  Внутри backend — вызовы методов через интерфейсы модулей.
  Это части одного приложения, а не отдельные микросервисы.
  При ошибке распознавания доступны пересъёмка и ручной ввод.
end note

Lay_R(auth, recognition)
Lay_R(recognition, dictionary)
Lay_R(dictionary, training)
Lay_R(training, stats)
Lay_R(ai, photos)
Lay_R(photos, db)

SHOW_LEGEND()
@enduml
